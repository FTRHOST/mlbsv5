VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Identitas operator untuk baris stats otomatis (dibaca server.py).
VITE_OPERATOR_ID=

# --- Overlay di PC yang SAMA dengan telemetry (default) ---
# Kosongkan = overlay konek ke WS lokal + baca historyMatch lokal.
# VITE_LOCAL_WS_URL=
# VITE_HISTORY_BASE_URL=

# --- Overlay di PC LAIN satu LAN (mode split-PC) ---
# Ganti 192.168.1.10 dengan IP PC telemetry (ipconfig / ifconfig).
# VITE_LOCAL_WS_URL=ws://192.168.1.10:8080
# VITE_HISTORY_BASE_URL=http://192.168.1.10:8081/historyMatch
# Lalu jalankan: npm run dev -- --host
# Firewall PC telemetry: izinkan port 8080 (WS) & 8081 (HTTP history).

# --- Otomatisasi scene OBS (scripts/auto_scene_switch.py) ---
# Aktifkan di OBS: Tools -> WebSocket Server Settings -> Enable Server (port 4455).
OBS_WS_HOST=localhost
OBS_WS_PORT=4455
OBS_WS_PASSWORD=
# URL WebSocket telemetry (telemetry/server.py). Di PC lain: ws://<ip-telemetry>:8080
TELEMETRY_WS_URL=ws://192.168.26.1:8080
